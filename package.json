{
  "name": "@tangle-network/charts",
  "version": "0.21.2",
  "description": "Static SVG and HTML figures for benchmarks and operational timing. Draws from producer data and refuses what it cannot draw honestly.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/charts.git"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/charts/issues"
  },
  "homepage": "https://github.com/tangle-network/charts",
  "sideEffects": [
    "./dist/figure.css",
    "./dist/react/live.css",
    "./dist/react/flow-waterfall.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./figure.css": "./dist/figure.css",
    "./react/live.css": "./dist/react/live.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/flow-waterfall.css": "./dist/react/flow-waterfall.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "gen:css": "node scripts/gen-css.mjs",
    "build": "node scripts/gen-css.mjs --check && tsdown && cp src/figure.css dist/figure.css && cp src/react/live.css dist/react/live.css && cp src/react/flow-waterfall.css dist/react/flow-waterfall.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tangle-network/brand": "1.24.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "tangle",
    "charts",
    "benchmarks",
    "svg"
  ]
}
