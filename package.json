{
  "name": "@tangle-network/charts",
  "version": "0.1.11",
  "description": "Benchmark figures as static SVG and HTML tables: ranked rates, cost frontier, comparison intervals, task matrix and breakdown. Draws from producer data and refuses what it cannot draw honestly.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/brand.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/brand/issues"
  },
  "homepage": "https://github.com/tangle-network/brand/tree/main/packages/charts",
  "sideEffects": [
    "./dist/figure.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./figure.css": "./dist/figure.css"
  },
  "scripts": {
    "gen:css": "node scripts/gen-css.mjs",
    "build": "node scripts/gen-css.mjs --check && tsdown && cp src/figure.css dist/figure.css"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "tangle",
    "charts",
    "benchmarks",
    "svg"
  ]
}
